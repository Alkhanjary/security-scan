# Copy this file to .env (in this same directory, next to scanner.py) and
# fill in your real key. This .env is loaded ONLY from this script's own
# directory — never from a directory you scan — so it's safe to keep here.

LLM_API_KEY=your-key-here
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:20b-cloud
